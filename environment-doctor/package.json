{
  "name": "environment-doctor",
  "version": "0.9.0",
  "private": true,
  "description": "Environment Doctor \u2014 sets up, diagnoses, fixes and verifies a PC and its dev environment.",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/write-cjs-marker.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:electron": "playwright test -c playwright.electron.config.ts",
    "cli": "node dist-electron/cli/doctor.js",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "author": {
    "name": "Environment Doctor"
  },
  "homepage": "https://github.com/doommsky/DOOM",
  "build": {
    "appId": "app.environmentdoctor.desktop",
    "productName": "Environment Doctor",
    "copyright": "Environment Doctor (working title)",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Environment-Doctor-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Environment Doctor",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Environment-Doctor-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  }
}
